 "_shapeVocabulary": {
  "_note": "PLAN 2z. Narrate; the AI writes the shape block. This map is a STARTING point and is expected to grow from the sessions themselves (D6 harvest) — recurring descriptions become 2y presets.",
  "give it a real attack / harder": "attack.from down, curve sudden, len down",
  "hit it and settle": "attack.peak 1.3-1.6 + a decay block",
  "stack the attack / double it": "attack.transient (hit-THEN-tone, ~0.5 s) or attack.noise (simultaneous, spare players)",
  "brassy / noisy start": "attack.noise cuivre (MIDI 60-67, AI folds the pitches) or edge technique flz / play_sing_ks",
  "assemble out of the air": "attack.entry ramp + motion converge + from 0",
  "let it fall apart / dissolve": "release.motion disperse + dropout + curve expo",
  "tongue-stop": "release {exit together, curve sudden}",
  "thin out but keep the beating": "release.dropout — cluster-safe, so beating thins by whole pairs",
  "come back to unison as it fades": "release.motion to-unison"
 }
